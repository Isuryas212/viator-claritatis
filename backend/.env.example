# Copy to .env on the server. Never commit real values.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-long-random-password
LITELLM_MASTER_KEY=sk-replace-with-long-random-secret
LITELLM_SALT_KEY=sk-replace-with-another-long-random-secret
LITELLM_API_KEY=
SITE_ORIGIN=https://isuryas212.github.io
VIATOR_API_PORT=8080
VIATOR_MODEL=viator-main
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

# Provider keys are optional. Add only the providers you choose.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
